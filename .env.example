# Server-only Neon pooled connection string. Never commit its value.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require

# Optional; defaults to 1800 seconds (30 minutes). Use a value of at least 300.
AUTH_SESSION_TTL_SECONDS=1800

# Optional integration settings preserved from the original site.
LASTFM_API_KEY=
LASTFM_USERNAME=
